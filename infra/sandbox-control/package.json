{
  "name": "t3code-sandbox-control",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "cd ../../apps/web && VITE_HOSTED_APP_URL=${SANDBOX_APP_URL:-http://localhost:8787} VITE_SANDBOX_DIRECTORY_URL=/api/sandboxes vp build --outDir ../../infra/sandbox-control/.web-dist --emptyOutDir",
    "dev": "cf dev",
    "deploy:test": "vp run build:web && cf deploy --mode test",
    "stage": "node scripts/stage-t3.ts",
    "mock": "node scripts/mock-upstream.ts",
    "e2e": "node scripts/e2e.ts",
    "e2e:ui": "playwright test",
    "test": "vp test run --config ../../vite.config.ts --dir .",
    "typecheck": "tsc-rs --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@playwright/test": "1.60.0",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "cf": "1.0.0-beta.17",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.150.0",
    "ws": "catalog:"
  }
}
