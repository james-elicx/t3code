{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t3-sandbox-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The hosted web client (apps/web build) on the apex, with SPA fallback.
  // The Worker runs first so sandbox subdomains and /api never reach assets.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "containers": [
    {
      "class_name": "ThreadSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        // Built from this branch's T3 server; run `vp run stage` first.
        "t3": { "dockerfile": "./container/Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "ThreadSandbox", "name": "THREAD_SANDBOX" },
      { "class_name": "SandboxDirectory", "name": "SANDBOX_DIRECTORY" },
    ],
  },
  "exports": {
    "ThreadSandbox": { "type": "durable-object", "storage": "sqlite" },
    "SandboxDirectory": { "type": "durable-object", "storage": "sqlite" },
  },
  // Local development: every upstream is the mock in scripts/mock-upstream.ts,
  // and the secrets in .dev.vars are placeholders. Production overrides these.
  "vars": {
    "SANDBOX_DOMAIN": "localhost",
    "AI_GATEWAY_BASE_URL": "http://127.0.0.1:8790/gateway/v1/poc-account/poc-gateway",
    "GITHUB_ORIGIN": "http://127.0.0.1:8790/github",
    "GITHUB_API_ORIGIN": "http://127.0.0.1:8790/github-api",
    "PUBLIC_EGRESS_HOSTS": "",
    "DEBUG_EXEC": "1",
  },
  "secrets": {
    "required": ["AI_GATEWAY_TOKEN", "GITHUB_WRITE_PAT", "GITHUB_READ_PAT"],
  },
}
